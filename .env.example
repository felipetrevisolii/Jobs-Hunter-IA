# JOBS HUNTER IA - CONFIGURACAO DE EXEMPLO
# Copie este arquivo para .env e preencha os dados privados.
# Nunca publique seu .env verdadeiro.

# LOCALIZACAO
CIDADES=Campinas,Valinhos,Hortolandia,Vinhedo
BUSCAR_REMOTAS_BRASIL=true

# BUSCAS
CARGOS_BUSCA=Analista de Automacao,Analista de Dados,Analista de BI,Desenvolvedor Junior,Estagio em Desenvolvimento,Analista de Suporte,Estagio em Dados,Estágio em Automação,Estágio em Inteligência Artificial,Estágio em BI,Estágio em Suporte Técnico
CARGOS_BUSCA_REMOTO=Analista de Automacao,Analista de Dados,Analista de BI,Desenvolvedor Junior,Estágio em Automação,Estágio em Dados,Estágio em BI,Estágio em Desenvolvimento,Estágio em Suporte de TI

# TIPOS DE OPORTUNIDADE
ACEITAR_ESTAGIO=true
ACEITAR_VINCULO_NAO_INFORMADO=true

# SALARIOS DE EMPREGOS
SALARIO_MINIMO=2500
SALARIO_FAIXA_BOA=3000
SALARIO_META=3500
ACEITAR_SALARIO_NAO_INFORMADO=true

# FILTROS E LIMITES
PONTUACAO_MINIMA_TI=55
IDADE_MAXIMA_VAGA_DIAS=30
MAX_VAGAS_POR_EXECUCAO=10
PAGINAS_POR_BUSCA=1
MAX_LINKS_TRABALHABRASIL=30
MAX_LINKS_EMPREGACAMPINAS=25
MAX_LINKS_INFOJOBS=25

# GOOGLE SHEETS
# Habilite somente depois de configurar as credenciais.
GOOGLE_SHEETS_ATIVO=false
GOOGLE_SHEETS_ABA_TI=Vagas_TI
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_JSON=credentials_google.json

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENVIAR_RESUMO_DIARIO=false

# SEGURANCA
# Inicia sem registrar nem notificar vagas.
MODO_TESTE=true
